# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Sadece seed/admin işlemleri için, sunucu tarafında kullanılır

# Admin Paneli Kimlik Doğrulama
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# B2B Bayi Paneli Kimlik Doğrulama
# Bayi oturumları için ayrı imza anahtarı — admin secret'tan farklı olmalıdır.
B2B_SESSION_SECRET=change-me-to-a-different-long-random-string

# White-Label Site Konfigürasyonu
# Yeni müşteriye uyarlarken bu değerleri güncelleyin — kod değişikliği gerekmez.
NEXT_PUBLIC_SITE_NAME="Fırat Elektronik"
NEXT_PUBLIC_SITE_TAGLINE="B2B Ürün Kataloğu"
NEXT_PUBLIC_FOOTER_TEXT="© 2026 Fırat Elektronik. Tüm Hakları Saklıdır."
NEXT_PUBLIC_ADMIN_PANEL_NAME="Unipro Admin"
